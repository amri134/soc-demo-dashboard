# Client-safe configuration. These values are bundled into the web app.
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<project-id>
VITE_APPWRITE_DATABASE_ID=soc_demo
VITE_APPWRITE_WORKSPACES_TABLE_ID=demo_workspaces
VITE_APPWRITE_ALERTS_TABLE_ID=demo_alerts
VITE_APPWRITE_INCIDENTS_TABLE_ID=incidents
VITE_APPWRITE_NOTES_TABLE_ID=incident_notes
VITE_APPWRITE_NOTIFICATIONS_TABLE_ID=demo_notifications
VITE_APPWRITE_AUDIT_LOGS_TABLE_ID=audit_logs
VITE_APPWRITE_EVIDENCE_BUCKET_ID=demo_evidence

# Server-only configuration. Never prefix an API key with VITE_ and never commit it.
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<project-id>
APPWRITE_API_KEY=<server-api-key>

